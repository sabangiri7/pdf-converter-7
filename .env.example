# Copy to .env and edit (never commit .env)
# Generate: openssl rand -hex 32   (or: python -c "import secrets; print(secrets.token_hex(32))")
PDF_TOOLS_SECRET_KEY=
PDF_TOOLS_PORT=5000
PDF_TOOLS_MAX_FILE_MB=50
PDF_TOOLS_MAX_FILES=20
PDF_TOOLS_MAX_PAGES=200
PDF_TOOLS_MAX_CONCURRENT_JOBS=2
PDF_TOOLS_JOB_TTL_SECONDS=3600
# Set true only behind HTTPS when exposing beyond localhost
PDF_TOOLS_COOKIE_SECURE=false
# Default false. Enabling requires a strong SECRET_KEY and HTTPS in front.
PUBLIC_DEPLOY=false
